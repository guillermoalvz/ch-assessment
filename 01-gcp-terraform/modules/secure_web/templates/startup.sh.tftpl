#!/bin/bash
set -euo pipefail
umask 027

# Official Ubuntu GCP images include Python 3, systemd and Google OS Login.
# Fail visibly instead of downloading dependencies with unrestricted egress.
test -x /usr/bin/python3
test -x /usr/bin/google_authorized_keys
install -d -m 0755 /opt/interview-web

cat > /opt/interview-web/app.py <<'APP_SOURCE'
${app_source}
APP_SOURCE
chmod 0644 /opt/interview-web/app.py

cat > /etc/systemd/system/interview-web.service <<'SERVICE'
[Unit]
Description=Private interview HTTP backend
After=network.target

[Service]
Type=simple
DynamicUser=yes
ExecStart=/usr/bin/python3 -I -B /opt/interview-web/app.py
Restart=on-failure
RestartSec=3
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_INET AF_UNIX
LockPersonality=yes
MemoryDenyWriteExecute=yes
MemoryMax=128M
TasksMax=16
# Application cannot call the metadata server or initiate API requests.
IPAddressDeny=any
IPAddressAllow=35.191.0.0/16
IPAddressAllow=130.211.0.0/22
IPAddressAllow=127.0.0.0/8

[Install]
WantedBy=multi-user.target
SERVICE

# Disable local-key/password/root bypasses while retaining Google-managed
# AuthorizedKeysCommand and PAM configuration for OS Login with 2FA.
cat > /etc/ssh/sshd_config.d/00-interview-hardening.conf <<'SSH_CONFIG'
PermitRootLogin no
PasswordAuthentication no
AuthorizedKeysFile none
AllowTcpForwarding no
AllowAgentForwarding no
X11Forwarding no
PermitTunnel no
SSH_CONFIG
chmod 0644 /etc/ssh/sshd_config.d/00-interview-hardening.conf
/usr/sbin/sshd -t
systemctl reload ssh.service

systemctl daemon-reload
systemctl enable interview-web.service
systemctl restart interview-web.service
