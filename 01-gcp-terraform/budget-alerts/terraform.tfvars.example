project_id         = "your-gcp-project-id"
billing_account_id = "000000-000000-000000"
# The account currency is read automatically. 5 means USD 5 on a USD account,
# or EUR 5 on a EUR account; the lower alert is always 20% of this amount.
monthly_budget_amount = 5
# Default recipients are billing account admins/users; optionally add yourself.
notification_emails = ["you@example.com"]
monthly_spike_multiplier = 1.5
